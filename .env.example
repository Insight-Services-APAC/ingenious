# =============================================================================
# Ingenious Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your actual values
# All environment variables use the INGENIOUS_ prefix

# =============================================================================
# REQUIRED: Azure OpenAI Configuration
# =============================================================================
INGENIOUS_MODELS__0__API_KEY=your-azure-openai-api-key-here
INGENIOUS_MODELS__0__BASE_URL=https://your-endpoint.cognitiveservices.azure.com/
INGENIOUS_MODELS__0__MODEL=gpt-4o-mini
INGENIOUS_MODELS__0__API_VERSION=2024-12-01-preview
INGENIOUS_MODELS__0__DEPLOYMENT=gpt-4o-mini-deployment
INGENIOUS_MODELS__0__API_TYPE=rest
INGENIOUS_MODELS__0__ROLE=chat

# =============================================================================
# Web Server Configuration
# =============================================================================
INGENIOUS_WEB_CONFIGURATION__IP_ADDRESS=0.0.0.0
INGENIOUS_WEB_CONFIGURATION__PORT=80

# =============================================================================
# CORS Configuration
# =============================================================================
# CORS allowed origins - comma-separated list of URLs
# Default: http://localhost,http://localhost:5173,http://localhost:4173
INGENIOUS_WEB_CONFIGURATION__CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:4173

# Allow credentials in CORS requests (cookies, authorization headers, etc.)
# Default: true
INGENIOUS_WEB_CONFIGURATION__CORS_ALLOW_CREDENTIALS=true

# Allowed HTTP methods for CORS - comma-separated list
# Use '*' to allow all methods
# Default: *
# INGENIOUS_WEB_CONFIGURATION__CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Allowed HTTP headers for CORS - comma-separated list
# Use '*' to allow all headers
# Default: *
# INGENIOUS_WEB_CONFIGURATION__CORS_ALLOW_HEADERS=Content-Type,Authorization

# =============================================================================
# Production CORS Example
# =============================================================================
# For production, restrict to specific domains:
# INGENIOUS_WEB_CONFIGURATION__CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# INGENIOUS_WEB_CONFIGURATION__CORS_ALLOW_CREDENTIALS=true
# INGENIOUS_WEB_CONFIGURATION__CORS_ALLOW_METHODS=GET,POST,PUT,DELETE
# INGENIOUS_WEB_CONFIGURATION__CORS_ALLOW_HEADERS=Content-Type,Authorization

# =============================================================================
# Authentication Configuration
# =============================================================================
INGENIOUS_WEB_CONFIGURATION__AUTHENTICATION__ENABLE=false
INGENIOUS_WEB_CONFIGURATION__AUTHENTICATION__USERNAME=admin
INGENIOUS_WEB_CONFIGURATION__AUTHENTICATION__PASSWORD=

# =============================================================================
# JWT Authentication Configuration
# =============================================================================
INGENIOUS_WEB_CONFIGURATION__AUTHENTICATION__JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
INGENIOUS_WEB_CONFIGURATION__AUTHENTICATION__JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
INGENIOUS_WEB_CONFIGURATION__AUTHENTICATION__JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Chat Service Configuration
# =============================================================================
INGENIOUS_CHAT_SERVICE__TYPE=multi_agent

# =============================================================================
# Chat History Storage
# =============================================================================
# Database type: 'sqlite' for local, 'azuresql' or 'cosmos' for cloud
INGENIOUS_CHAT_HISTORY__DATABASE_TYPE=sqlite
INGENIOUS_CHAT_HISTORY__DATABASE_PATH=./.tmp/chat_history.db

# =============================================================================
# Logging Configuration
# =============================================================================
INGENIOUS_LOGGING__ROOT_LOG_LEVEL=info
INGENIOUS_LOGGING__LOG_LEVEL=info

# =============================================================================
# OPTIONAL: Azure Search Configuration
# =============================================================================
# INGENIOUS_AZURE_SEARCH_SERVICES__0__KEY=your-search-api-key
# INGENIOUS_AZURE_SEARCH_SERVICES__0__ENDPOINT=https://your-search-service.search.windows.net

# =============================================================================
# OPTIONAL: Azure SQL Configuration
# =============================================================================
# INGENIOUS_CHAT_HISTORY__DATABASE_TYPE=azuresql
# INGENIOUS_CHAT_HISTORY__DATABASE_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:your-server.database.windows.net,1433;Database=your-database;Uid=your-username;Pwd=your-password;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"

# =============================================================================
# OPTIONAL: File Storage Configuration
# =============================================================================
# INGENIOUS_FILE_STORAGE__REVISIONS__STORAGE_TYPE=local
# INGENIOUS_FILE_STORAGE__REVISIONS__PATH=./
# INGENIOUS_FILE_STORAGE__DATA__STORAGE_TYPE=local
# INGENIOUS_FILE_STORAGE__DATA__PATH=./

# =============================================================================
# Working Directory (Required)
# =============================================================================
INGENIOUS_WORKING_DIR=.
