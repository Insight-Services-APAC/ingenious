# Example .env configuration for Ingenious with Managed Identity support
# This file demonstrates how to configure keyless authentication for Azure services

# =============================================================================
# OpenAI Configuration with Managed Identity
# =============================================================================

# Option 1: Using API Key (existing approach)
INGENIOUS_MODELS__0__MODEL=gpt-4
INGENIOUS_MODELS__0__API_TYPE=rest
INGENIOUS_MODELS__0__API_VERSION=2024-12-01-preview
INGENIOUS_MODELS__0__DEPLOYMENT=your-gpt4-deployment-name
INGENIOUS_MODELS__0__API_KEY=your-actual-api-key-here
INGENIOUS_MODELS__0__BASE_URL=https://your-resource.openai.azure.com/
INGENIOUS_MODELS__0__USE_MANAGED_IDENTITY=false

# Option 2: Using Managed Identity (keyless)
# INGENIOUS_MODELS__0__MODEL=gpt-4
# INGENIOUS_MODELS__0__API_TYPE=rest
# INGENIOUS_MODELS__0__API_VERSION=2024-12-01-preview
# INGENIOUS_MODELS__0__DEPLOYMENT=your-gpt4-deployment-name
# INGENIOUS_MODELS__0__BASE_URL=https://your-resource.openai.azure.com/
# INGENIOUS_MODELS__0__USE_MANAGED_IDENTITY=true
# # Note: API_KEY is not needed when using managed identity

# =============================================================================
# Azure Cognitive Search Configuration with Managed Identity
# =============================================================================

# Option 1: Using API Key (existing approach)
INGENIOUS_AZURE_SEARCH_SERVICES__0__SERVICE=your-search-service
INGENIOUS_AZURE_SEARCH_SERVICES__0__ENDPOINT=https://your-search-service.search.windows.net
INGENIOUS_AZURE_SEARCH_SERVICES__0__KEY=your-search-api-key
INGENIOUS_AZURE_SEARCH_SERVICES__0__USE_MANAGED_IDENTITY=false

# Option 2: Using Managed Identity (keyless)
# INGENIOUS_AZURE_SEARCH_SERVICES__0__SERVICE=your-search-service
# INGENIOUS_AZURE_SEARCH_SERVICES__0__ENDPOINT=https://your-search-service.search.windows.net
# INGENIOUS_AZURE_SEARCH_SERVICES__0__USE_MANAGED_IDENTITY=true
# # Note: KEY is not needed when using managed identity

# =============================================================================
# Azure Cosmos DB Configuration with Managed Identity (NEW)
# =============================================================================

# Option 1: Using Account Key
INGENIOUS_AZURE_COSMOS_SERVICES__ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
INGENIOUS_AZURE_COSMOS_SERVICES__KEY=your-cosmos-account-key==
INGENIOUS_AZURE_COSMOS_SERVICES__DATABASE_NAME=your-database-name
INGENIOUS_AZURE_COSMOS_SERVICES__CONTAINER_NAME=your-container-name
INGENIOUS_AZURE_COSMOS_SERVICES__USE_MANAGED_IDENTITY=false

# Option 2: Using Managed Identity (keyless)
# INGENIOUS_AZURE_COSMOS_SERVICES__ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
# INGENIOUS_AZURE_COSMOS_SERVICES__DATABASE_NAME=your-database-name
# INGENIOUS_AZURE_COSMOS_SERVICES__CONTAINER_NAME=your-container-name
# INGENIOUS_AZURE_COSMOS_SERVICES__USE_MANAGED_IDENTITY=true
# # Note: KEY is not needed when using managed identity

# =============================================================================
# Required Basic Settings
# =============================================================================
INGENIOUS_CHAT_SERVICE__TYPE=multi_agent
INGENIOUS_CHAT_HISTORY__DATABASE_TYPE=sqlite
INGENIOUS_CHAT_HISTORY__DATABASE_PATH=./.tmp/chat_history.db
INGENIOUS_CHAT_HISTORY__MEMORY_PATH=./.tmp

# =============================================================================
# Managed Identity Setup Requirements
# =============================================================================
#
# When using managed identity, ensure the following Azure roles are assigned:
#
# For Azure OpenAI:
# - "Cognitive Services OpenAI User" role on the OpenAI resource
#
# For Azure Cognitive Search:
# - "Search Index Data Reader" role on the Search service
# - "Search Service Contributor" role (if creating/managing indexes)
#
# For Azure Cosmos DB:
# - "Cosmos DB Built-in Data Reader" role on the Cosmos account
# - "Cosmos DB Built-in Data Contributor" role (if writing data)
#
# Managed Identity Types Supported:
# - System-assigned managed identity (automatically created with Azure resource)
# - User-assigned managed identity (manually created and assigned)
# - Azure CLI/PowerShell credentials (for local development)
# - Visual Studio/VS Code credentials (for local development)
#
# =============================================================================
# Mixed Authentication Example
# =============================================================================
#
# You can mix authentication methods across services:
# - OpenAI with API Key
# - Search with Managed Identity
# - Cosmos with Account Key
#
# Just set USE_MANAGED_IDENTITY=true for services that should use managed identity
# and provide keys for services that should use key-based authentication.
#
# =============================================================================